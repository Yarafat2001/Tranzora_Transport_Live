{
  "name": "tranzora-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:integration": "node --test tests/backend.integration.mjs",
    "test:ui": "playwright test",
    "test:contrast": "playwright test tests/ui/contrast.spec.ts tests/ui/palette.spec.ts tests/ui/loading-colors.spec.ts",
    "test:driver": "node --test tests/driver.integration.mjs",
    "test:oauth": "node --test tests/oauth.integration.mjs",
    "seed:demo": "dotnet run --project backend/Tranzora.Api -- --environment Development --seed-demo",
    "test:demo": "node --test tests/demo.integration.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "next": "^16.3.3",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
